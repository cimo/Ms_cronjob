{
    "name": "ms_cronjob",
    "version": "1.0.0",
    "description": "Microservice cronjob.",
    "author": "cimo",
    "license": "MIT",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/cimo/Ms_cronjob.git"
    },
    "type": "module",
    "scripts": {
        "delete_dist": "node -e \"const fs = require('fs'); try{ fs.rmdirSync('./dist/', { recursive: true }) } catch{}; process.exit(0);\"",
        "check": "eslint --no-cache --config eslint.config.js",
        "build_tsc": "npm run delete_dist && tsc --build tsconfig.tsc.json",
        "build": "npm run build_tsc && npm run check",
        "execute": "nodemon --config nodemon.json"
    },
    "dependencies": {
        "@cimo/environment": "1.0.31",
        "@cimo/cronjob": "1.0.19"
    },
    "devDependencies": {
        "@types/node": "25.3.0",
        "@typescript-eslint/parser": "8.65.0",
        "@typescript-eslint/eslint-plugin": "8.65.0",
        "typescript": "5.7.2",
        "nodemon": "3.1.14",
        "prettier": "3.4.2",
        "eslint": "10.8.0",
        "eslint-plugin-prettier": "5.5.6"
    },
    "overrides": {}
}
